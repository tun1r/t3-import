+import { expect, it } from "@effect/vitest";
+import * as NodeServices from "@effect/platform-node/NodeServices";
+import { ProjectId, ProviderInstanceId, ProviderDriverKind } from "@t3tools/contracts";
+import * as Effect from "effect/Effect";
+import * as Layer from "effect/Layer";
+import * as ServerSettings from "../serverSettings.ts";
+import * as Source from "./AgentSessionNativeSource.ts";
+import * as Transport from "./AgentSessionNativeTransport.ts";
+
+const projectId = ProjectId.make("project");
+const instanceId = ProviderInstanceId.make("codex-personal");
+const thread = {
+  id: "native-thread",
+  cwd: "/workspace/project",
+  status: { type: "idle" },
+  createdAt: 1790000000,
+  updatedAt: 1790000001,
+  historyMode: "paginated",
+  turns: [],
+};
+const turn = (id: string) => ({
+  id,
+  status: "completed",
+  itemsView: "full",
+  items: [{ id: `item-${id}`, type: "agentMessage", text: id }],
+});
+const layer = (request: Transport.NativeHistoryClient["request"]) =>
+  Source.layer.pipe(
+    Layer.provide(
+      Layer.succeed(Transport.AgentSessionNativeTransport, {
+        withClient: (_instance, _directory, use) => use({ request }),
+      }),
+    ),
+    Layer.provide(
+      ServerSettings.layerTest({
+        providerInstances: {
+          [instanceId]: { driver: ProviderDriverKind.make("codex"), enabled: true },
+          [ProviderInstanceId.make("opencode")]: {
+            driver: ProviderDriverKind.make("opencode"),
+            enabled: true,
+          },
+        },
+      }),
+    ),
+    Layer.provide(NodeServices.layer),
+  );
+const input = {
+  projectId,
+  source: "codex" as const,
+  providerInstanceId: instanceId,
+  sessionId: thread.id,
+};
+
+it.effect(
+  "reads all Codex pages, retains native binding and produces a stable ledger identity",
+  () => {
+    const calls: Array<Readonly<Record<string, unknown>>> = [];
+    return Effect.gen(function* () {
+      const source = yield* Source.AgentSessionNativeSource;
+      const first = yield* source.read(input, thread.cwd);
+      const second = yield* source.read(input, thread.cwd);
+      expect(first).toEqual(second);
+      expect(first.thread.messages.map((m) => m.text)).toEqual(["t1", "t2"]);
+      expect(first.thread.providerInstanceId).toBe(instanceId);
+      expect(first.source.filePath).toMatch(/^native:\/\/codex\/codex-personal\//);
+      expect(calls.filter((p) => p.cursor === "page-2")).toHaveLength(4);
+    }).pipe(
+      Effect.provide(
+        layer((method, params) => {
+          calls.push(params);
+          return Effect.succeed(
+            method === "thread/read"
+              ? { thread }
+              : {
+                  data: [turn(params.cursor ? "t2" : "t1")],
+                  nextCursor: params.cursor ? null : "page-2",
+                },
+          );
+        }),
+      ),
+    );
+  },
+);
+it.effect("rejects a repeated pagination cursor instead of truncating", () =>
+  Effect.gen(function* () {
+    const source = yield* Source.AgentSessionNativeSource;
+    expect(yield* Effect.flip(source.read(input, thread.cwd))).toMatchObject({
+      reason: "protocol",
+    });
+  }).pipe(
+    Effect.provide(
+      layer((method) =>
+        Effect.succeed(
+          method === "thread/read" ? { thread } : { data: [turn("t1")], nextCursor: "repeat" },
+        ),
+      ),
+    ),
+  ),
+);
+it.effect("rejects active Codex threads before reading turn pages", () =>
+  Effect.gen(function* () {
+    const source = yield* Source.AgentSessionNativeSource;
+    expect(yield* Effect.flip(source.read(input, thread.cwd))).toMatchObject({ reason: "active" });
+  }).pipe(
+    Effect.provide(
+      layer(() => Effect.succeed({ thread: { ...thread, status: { type: "active" } } })),
+    ),
+  ),
+);
+it.effect("rejects provider instance mismatch", () =>
+  Effect.gen(function* () {
+    const source = yield* Source.AgentSessionNativeSource;
+    expect(
+      yield* Effect.flip(source.read({ ...input, source: "opencode" }, thread.cwd)),
+    ).toMatchObject({ reason: "configuration" });
+  }).pipe(Effect.provide(layer(() => Effect.die("Transport must not be reached")))),
+);
+it.effect("rejects a workspace mismatch", () =>
+  Effect.gen(function* () {
+    const source = yield* Source.AgentSessionNativeSource;
+    expect(yield* Effect.flip(source.read(input, "/workspace/other"))).toMatchObject({
+      reason: "identity",
+    });
+  }).pipe(
+    Effect.provide(
+      layer((method) =>
+        Effect.succeed(
+          method === "thread/read" ? { thread } : { data: [turn("t1")], nextCursor: null },
+        ),
+      ),
+    ),
+  ),
+);
+it.effect("rejects Codex history that changes while reading", () => {
+  let reads = 0;
+  return Effect.gen(function* () {
+    const source = yield* Source.AgentSessionNativeSource;
+    expect(yield* Effect.flip(source.read(input, thread.cwd))).toMatchObject({ reason: "changed" });
+  }).pipe(
+    Effect.provide(
+      layer((method) =>
+        Effect.sync(() =>
+          method === "thread/read"
+            ? { thread: { ...thread, updatedAt: thread.updatedAt + reads++ } }
+            : { data: [turn("t1")], nextCursor: null },
+        ),
+      ),
+    ),
+  );
+});
+it.effect("lists both current and archived Codex sessions without exposing config", () =>
+  Effect.gen(function* () {
+    const source = yield* Source.AgentSessionNativeSource;
+    const result = yield* source.list({ source: "codex", providerInstanceId: instanceId });
+    expect(result.sessions.map((s) => s.sessionId)).toEqual(["archived", "native-thread"]);
+    expect(Object.keys(result.sessions[0]!)).toEqual([
+      "source",
+      "providerInstanceId",
+      "sessionId",
+      "workspaceRoot",
+      "title",
+      "updatedAt",
+    ]);
+  }).pipe(
+    Effect.provide(
+      layer((_method, params) =>
+        Effect.succeed({
+          data: [
+            {
+              ...thread,
+              ...(params.archived ? { id: "archived", updatedAt: thread.updatedAt + 1 } : {}),
+            },
+          ],
+          nextCursor: null,
+        }),
+      ),
+    ),
+  ),
+);
+
+const info = {
+  id: "ses_example",
+  title: "OpenCode 2",
+  location: { directory: thread.cwd },
+  time: { created: "2026-09-01T10:00:00.000Z", updated: "2026-09-01T10:01:00.000Z" },
+};
+const snapshot = {
+  info,
+  messages: [{ id: "msg_u", type: "user", text: "hello", time: info.time }],
+};
+const openInput = { projectId, source: "opencode" as const, sessionId: info.id };
+it.effect("imports a stable OpenCode 2 export with native instance and ID", () =>
+  Effect.gen(function* () {
+    const source = yield* Source.AgentSessionNativeSource;
+    const result = yield* source.read(openInput, thread.cwd);
+    expect(result.thread).toMatchObject({
+      source: "opencode",
+      providerSessionId: info.id,
+      providerInstanceId: "opencode",
+      messages: [{ text: "hello" }],
+    });
+  }).pipe(
+    Effect.provide(
+      layer((method) => Effect.succeed(method === "active" ? { data: {} } : snapshot)),
+    ),
+  ),
+);
+it.effect("rejects active OpenCode sessions", () =>
+  Effect.gen(function* () {
+    const source = yield* Source.AgentSessionNativeSource;
+    expect(yield* Effect.flip(source.read(openInput, thread.cwd))).toMatchObject({
+      reason: "active",
+    });
+  }).pipe(
+    Effect.provide(layer(() => Effect.succeed({ data: { [info.id]: { type: "running" } } }))),
+  ),
+);
+it.effect("rejects changed OpenCode exports", () => {
+  let reads = 0;
+  return Effect.gen(function* () {
+    const source = yield* Source.AgentSessionNativeSource;
+    expect(yield* Effect.flip(source.read(openInput, thread.cwd))).toMatchObject({
+      reason: "changed",
+    });
+  }).pipe(
+    Effect.provide(
+      layer((method) =>
+        Effect.succeed(method === "active" ? { data: {} } : { ...snapshot, revision: reads++ }),
+      ),
+    ),
+  );
+});
+
+it.effect("hydrates paginated OpenCode shell output before projecting it", () =>
+  Effect.gen(function* () {
+    const source = yield* Source.AgentSessionNativeSource;
+    const result = yield* source.read(openInput, thread.cwd);
+    expect(result.thread.messages[0]?.activities?.[0]).toMatchObject({
+      kind: "tool",
+      output: "abcdef",
+      status: "failed",
+    });
+  }).pipe(
+    Effect.provide(
+      layer((method, params) =>
+        Effect.succeed(
+          method === "active"
+            ? { data: {} }
+            : method === "shellOutput"
+              ? {
+                  data: {
+                    output: params.cursor === 0 ? "abc" : "def",
+                    cursor: params.cursor === 0 ? 3 : 6,
+                    size: 6,
+                    truncated: params.cursor === 0,
+                  },
+                }
+              : {
+                  info,
+                  messages: [
+                    {
+                      id: "msg_shell",
+                      shellID: "sh_fixture",
+                      type: "shell",
+                      command: "false",
+                      status: "exited",
+                      exit: 1,
+                      time: { created: info.time.created, completed: info.time.updated },
+                      output: { output: "def", cursor: 6, size: 6, truncated: true },
+                    },
+                  ],
+                },
+        ),
+      ),
+    ),
+  ),
+);
+
+it.effect("uses the implicit default Codex instance on a fresh T3 installation", () =>
+  Effect.gen(function* () {
+    const source = yield* Source.AgentSessionNativeSource;
+    expect(yield* source.list({ source: "codex" })).toEqual({ sessions: [] });
+  }).pipe(
+    Effect.provide(
+      Source.layer.pipe(
+        Layer.provide(
+          Layer.succeed(Transport.AgentSessionNativeTransport, {
+            withClient: (instance, _directory, use) => {
+              expect(instance.driver).toBe("codex");
+              return use({ request: () => Effect.succeed({ data: [], nextCursor: null }) });
+            },
+          }),
+        ),
+        Layer.provide(ServerSettings.layerTest({ providerInstances: {} })),
+        Layer.provide(NodeServices.layer),
+      ),
+    ),
+  ),
+);
