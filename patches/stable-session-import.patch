+                    type: "file",
+                    uri: "data:application/octet-stream;base64,AP8=",
+                    mime: "application/octet-stream",
+                    name: "result.bin",
+                  },
+                ],
+              },
+            },
+          ],
+        },
+      ],
+    },
+    instance,
+  );
+  expect(opencode.messages[0]?.files?.[0]).toMatchObject({
+    name: "result.bin",
+    sizeBytes: 2,
+    dataUrl: "data:application/octet-stream;base64,AP8=",
+  });
+  const codexThread = parseCodexSession(
+    codex([
+      {
+        id: "image_tool",
+        type: "mcpToolCall",
+        server: "images",
+        tool: "get",
+        result: { content: [{ type: "image", mimeType: "image/png", data: "aGVsbG8=" }] },
+      },
+    ]),
+    instance,
+  );
+  expect(codexThread.messages[0]?.images?.[0]?.sizeBytes).toBe(5);
+});
+
+it("groups OpenCode steered prompts until the native idle boundary", () => {
+  const thread = parseOpenCode2Session(
+    {
+      info,
+      messages: [
+        { id: "msg_first", type: "user", text: "Start", time: at },
+        { id: "msg_steer", type: "user", text: "Also check", time: at },
+        { id: "msg_idle", type: "idle", outcome: "interrupted", time: at },
+        { id: "msg_next", type: "user", text: "Continue", time: at },
+      ],
+    },
+    instance,
+  );
+  expect(thread.messages.map((m) => m.sourceTurnId)).toEqual([
+    "msg_first",
+    "msg_first",
+    "msg_first",
+    "msg_next",
+  ]);
+  expect(thread.messages[2]?.status).toBe("interrupted");
+});
+
+it("preserves native terminal errors even without a visible assistant answer", () => {
+  const failed = parseCodexSession(
+    {
+      ...codex([]),
+      turns: [
+        {
+          id: "failed-turn",
+          status: "failed",
+          items: [],
+          error: { message: "Synthetic provider failure" },
+        },
+      ],
+    },
+    instance,
+  );
+  expect(failed.messages[0]).toMatchObject({ status: "failed", sourceTurnId: "failed-turn" });
+  expect(failed.messages[0]?.text).toContain("Synthetic provider failure");
+  const partial = parseOpenCode2Session(
+    {
+      info,
+      messages: [
+        {
+          id: "msg_error",
+          type: "assistant",
+          time: at,
+          content: [{ type: "text", text: "Partial answer" }],
+          error: { message: "Synthetic interruption" },
+        },
+      ],
+    },
+    instance,
+  );
+  expect(partial.messages.at(-1)).toMatchObject({ status: "failed" });
+  expect(partial.messages.at(-1)?.text).toContain("Synthetic interruption");
+});
diff --git a/apps/server/src/project/AgentSessionNative.ts b/apps/server/src/project/AgentSessionNative.ts
new file mode 100644
index 0000000000..bc78d099f2
--- /dev/null
+++ b/apps/server/src/project/AgentSessionNative.ts
@@ -0,0 +1,470 @@
+import type { ProviderInstanceId } from "@t3tools/contracts";
+import * as DateTime from "effect/DateTime";
+import type {
+  AgentSessionActivity,
+  AgentSessionImageAttachment,
+  AgentSessionSubagentActivity,
+  AgentSessionThread,
+  AgentSessionThreadMessage,
+} from "./AgentSessionScanner.ts";
+
+export const record = (value: unknown): Readonly<Record<string, unknown>> =>
+  typeof value === "object" && value !== null && !Array.isArray(value)
+    ? (value as Record<string, unknown>)
+    : {};
+export const array = (value: unknown): ReadonlyArray<unknown> =>
+  Array.isArray(value) ? value : [];
+export const string = (value: unknown): string => (typeof value === "string" ? value : "");
+const required = (value: unknown, field: string) => {
+  const text = string(value);
+  if (!text.trim()) throw new Error(`Native session is missing ${field}.`);
+  return text;
+};
+const iso = (value: unknown, fallback: string, seconds = false): string => {
+  if (DateTime.isDateTime(value)) return DateTime.formatIso(value);
+  if (value === null || value === undefined) return fallback;
+  const millis =
+    typeof value === "number" ? value * (seconds ? 1000 : 1) : Date.parse(string(value));
+  if (!Number.isFinite(millis)) throw new Error("Native session has an invalid timestamp.");
+  return DateTime.formatIso(DateTime.makeUnsafe(millis));
+};
+const epoch = "1970-01-01T00:00:00.000Z";
+const statusOf = (value: unknown): NonNullable<AgentSessionThreadMessage["status"]> => {
+  switch (value) {
+    case "failed":
+    case "errored":
+    case "notFound":
+    case "timeout":
+    case "error":
+      return "failed";
+    case "interrupted":
+    case "inProgress":
+    case "running":
+    case "streaming":
+    case "shutdown":
+    case "spawned":
+    case "killed":
+    case "pending":
+      return "interrupted";
+    case "declined":
+    case "cancelled":
+    case "canceled":
+      return "cancelled";
+    default:
+      return "completed";
+  }
+};
+const modelOf = (value: unknown): string | null => {
+  if (typeof value === "string") return value;
+  const model = record(value);
+  return model.modelID ? `${string(model.providerID)}/${string(model.modelID)}` : null;
+};
+const textOf = (value: unknown): string => {
+  if (typeof value === "string") return value;
+  return array(value)
+    .map((entry) => {
+      if (typeof entry === "string") return entry;
+      const part = record(entry);
+      if (part.type === "file")
+        return `[File: ${string(part.name) || string(part.mime)}${string(part.uri).startsWith("data:") ? "" : ` ${string(part.uri)}`}]`;
+      return string(part.text);
+    })
+    .filter(Boolean)
+    .join("\n");
+};
+function image(url: unknown, name: string): AgentSessionImageAttachment | undefined {
+  const match = /^data:(image\/[a-z0-9.+-]+);base64,([A-Za-z0-9+/]*={0,2})$/i.exec(string(url));
+  if (!match) return undefined;
+  const encoded = match[2]!;
+  return {
+    name,
+    mimeType: match[1]!,
+    sizeBytes: Buffer.from(encoded, "base64").byteLength,
+    dataUrl: string(url),
+  };
+}
+function contentAttachments(value: unknown) {
+  const images: Array<AgentSessionImageAttachment> = [];
+  const files: Array<AgentSessionImageAttachment> = [];
+  for (const entry of array(value)) {
+    const part = record(entry);
+    const mime = string(part.mime ?? part.mimeType) || "application/octet-stream";
+    const uri =
+      string(part.uri ?? part.url ?? part.imageUrl) ||
+      (part.data ? `data:${mime};base64,${string(part.data)}` : "");
+    const match = /^data:([^;,]+);base64,([A-Za-z0-9+/]+={0,2})$/i.exec(uri);
+    if (!match) continue;
+    const attachment = {
+      name: string(part.name) || "attachment",
+      mimeType: match[1]!,
+      sizeBytes: Buffer.from(match[2]!, "base64").byteLength,
+      dataUrl: uri,
+    };
+    if (attachment.mimeType.startsWith("image/")) images.push(attachment);
+    else files.push(attachment);
+  }
+  return { images, files };
+}
+const tool = (
+  source: "codex" | "opencode",
+  item: Readonly<Record<string, unknown>>,
+  createdAt: string,
+  completedAt: string,
+): AgentSessionActivity => {
+  const state = source === "opencode" ? record(item.state) : item;
+  const status = statusOf(state.status ?? (state.error ? "failed" : "completed"));
+  return {
+    kind: "tool",
+    id: required(item.id, "tool ID"),
+    name: string(item.name ?? item.tool ?? item.type) || "Tool",
+    input: state.input ?? item.arguments ?? item,
+    output:
+      string(item.aggregatedOutput) ||
+      textOf(state.content) ||
+      textOf(record(item.result).content) ||
+      string(record(state.error).message) ||
+      null,
+    failed: status === "failed",
+    status,
+    createdAt,
+    completedAt,
+    native: { source, item },
+  };
+};
+
+export function parseCodexSession(
+  value: unknown,
+  providerInstanceId: ProviderInstanceId,
+): AgentSessionThread {
+  const thread = record(value);
+  const id = required(thread.id, "Codex thread ID");
+  required(thread.cwd, "Codex workspace");
+  if (!Array.isArray(thread.turns)) throw new Error("Codex turn history was not loaded.");
+  const createdAt = iso(thread.createdAt, epoch, true);
+  const updatedAt = iso(thread.updatedAt, createdAt, true);
+  const messages: Array<AgentSessionThreadMessage> = [];
+  let model = modelOf(thread.model);
+  for (const rawTurn of thread.turns) {
+    const turn = record(rawTurn);
+    if (
+      turn.itemsView === "summary" ||
+      turn.itemsView === "notLoaded" ||
+      !Array.isArray(turn.items)
+    )
+      throw new Error("Codex turn items were not fully loaded.");
+    const started = iso(turn.startedAt, createdAt, true);
+    const completed = iso(turn.completedAt, started, true);
+    model = modelOf(turn.model) ?? model;
+    for (const rawItem of turn.items) {
+      const item = record(rawItem);
+      const sourceId = required(item.id, "Codex item ID");
+      const common = {
+        sourceId,
+        sourceTurnId: required(turn.id, "Codex turn ID"),
+        createdAt: started,
+        completedAt: completed,
+        status: statusOf(turn.status),
+      };
+      if (item.type === "userMessage") {
+        const images: Array<AgentSessionImageAttachment> = [];
+        const localImages: Array<string> = [];
+        const text: Array<string> = [];
+        for (const rawContent of array(item.content)) {
+          const content = record(rawContent);
+          if (content.type === "text") text.push(string(content.text));
+          else if (content.type === "localImage")
+            localImages.push(required(content.path, "image path"));
+          else if (content.type === "image") {
+            const inline = image(content.url, `image-${images.length + 1}`);
+            if (inline) images.push(inline);
+            else text.push(`[Image: ${string(content.url)}]`);
+          } else text.push(JSON.stringify(content));
+        }
+        messages.push({
+          ...common,
+          role: "user",
+          text: text.join("\n"),
+          images,
+          localImages,
+          status: "completed",
+        });
+      } else if (item.type === "agentMessage") {
+        messages.push({ ...common, role: "assistant", text: string(item.text) });
+      } else if (item.type === "reasoning") {
+        const text = [
+          ...new Set([textOf(item.summary), textOf(item.content)].filter(Boolean)),
+        ].join("\n\n");
+        messages.push({
+          ...common,
+          role: "assistant",
+          text: "",
+          activities: [{ kind: "reasoning", text, createdAt: started }],
+        });
+      } else if (item.type === "contextCompaction") {
+        messages.push({
+          ...common,
+          role: "assistant",
+          text: "",
+          activities: [{ kind: "compaction", createdAt: started }],
+        });
+      } else {
+        const subagents: Array<AgentSessionSubagentActivity> = [];
+        if (item.type === "collabAgentToolCall") {
+          for (const child of array(item.receiverThreadIds)) {
+            const state = record(record(item.agentsStates)[string(child)]);
+            const status = statusOf(state.status ?? item.status);
+            subagents.push({
+              id: required(child, "Codex child thread ID"),
+              prompt: string(item.prompt),
+              title: string(item.tool),
+              result: string(state.message) || null,
+              status: status === "cancelled" ? "interrupted" : status,
+              createdAt: started,
+              completedAt: completed,
+            });
+          }
+        }
+        const attachments = contentAttachments([
+          ...array(record(item.result).content),
+          ...array(item.contentItems),
+        ]);
+        const localImages: Array<string> = [];
+        if (item.type === "imageView") localImages.push(required(item.path, "viewed image path"));
+        if (item.type === "imageGeneration" && string(item.result)) {
+          const result = string(item.result);
+          const inline = image(
+            result.startsWith("data:") ? result : `data:image/png;base64,${result}`,
+            "generated-image",
+          );
+          if (inline) attachments.images.push(inline);
+        }
+        messages.push({
+          ...common,
+          role: "assistant",
+          text: "",
+          ...attachments,
+          localImages,
+          subagents,
+          activities: [tool("codex", item, started, completed)],
+        });
+      }
+    }
+    if (turn.error || turn.items.length === 0) {
+      const sourceTurnId = required(turn.id, "Codex turn ID");
+      messages.push({
+        sourceId: `${sourceTurnId}:terminal`,
+        sourceTurnId,
+        role: "assistant",
+        text: turn.error ? JSON.stringify(turn.error) : `[Native turn ${string(turn.status)}]`,
+        status: statusOf(turn.status),
+        createdAt: started,
+        completedAt: completed,
+      });
+    }
+  }
+  return {
+    source: "codex",
+    providerInstanceId,
+    providerSessionId: id,
+    title: string(thread.name) || string(thread.preview).slice(0, 100) || "Imported Codex session",
+    model,
+    createdAt,
+    updatedAt,
+    messages,
+  };
+}
+
+export function parseOpenCode2Session(
+  value: unknown,
+  providerInstanceId: ProviderInstanceId,
+): AgentSessionThread {
+  const snapshot = record(value);
+  const info = record(snapshot.info);
+  const id = required(info.id, "OpenCode session ID");
+  required(record(info.location).directory, "OpenCode 2 location");
+  if (!id.startsWith("ses_") || !Array.isArray(snapshot.messages))
+    throw new Error("Not an OpenCode 2 session export.");
+  const createdAt = iso(record(info.time).created, epoch);
+  const updatedAt = iso(record(info.time).updated, createdAt);
+  const messages: Array<AgentSessionThreadMessage> = [];
+  const boundary = string(record(info.revert).messageID);
+  if (boundary && !snapshot.messages.some((m) => record(m).id === boundary))
+    throw new Error("OpenCode revert boundary is missing from the export.");
+  let nativeTurnId: string | undefined;
+  for (const rawMessage of snapshot.messages) {
+    const message = record(rawMessage);
+    const sourceId = required(message.id, "OpenCode message ID");
+    if (boundary && sourceId === boundary) break;
+    const started = iso(record(message.time).created, createdAt);
+    const completed = iso(record(message.time).completed, started);
+    nativeTurnId ??= sourceId;
+    const common = {
+      sourceId,
+      sourceTurnId: nativeTurnId,
+      createdAt: started,
+      completedAt: completed,
+      status: statusOf(
+        message.error ||
+          (message.type === "shell" &&
+            message.status === "exited" &&
+            typeof message.exit === "number" &&
+            message.exit !== 0)
+          ? "failed"
+          : (message.status ?? message.outcome),
+      ),
+    };
+    if (message.type === "user") {
+      const images: Array<AgentSessionImageAttachment> = [];
+      const files: Array<AgentSessionImageAttachment> = [];
+      for (const rawFile of array(message.files)) {
+        const file = record(rawFile);
+        const mime = string(file.mime) || "application/octet-stream";
+        if (mime.startsWith("image/")) {
+          const inline = image(
+            `data:${mime};base64,${string(file.data)}`,
+            string(file.name) || `image-${images.length + 1}`,
+          );
+          if (inline) images.push(inline);
+        } else
+          files.push({
+            name: string(file.name) || "attachment",
+            mimeType: mime,
+            sizeBytes: Buffer.from(string(file.data), "base64").byteLength,
+            dataUrl: `data:${mime};base64,${string(file.data)}`,
+          });
+      }
+      messages.push({ ...common, role: "user", text: string(message.text), images, files });
+    } else if (message.type === "assistant") {
+      if (array(message.content).length === 0)
+        messages.push({
+          ...common,
+          role: "assistant",
+          text: string(record(message.error).message) || JSON.stringify(message.error ?? message),
+        });
+      // Preserve block order: a provider message may interleave text, reasoning and tools.
+      for (const [index, rawContent] of array(message.content).entries()) {
+        const content = record(rawContent);
+        const part = { ...common, sourceId: `${sourceId}:${string(content.id) || index}` };
+        if (content.type === "text")
+          messages.push({ ...part, role: "assistant", text: string(content.text) });
+        else if (content.type === "reasoning")
+          messages.push({
+            ...part,
+            role: "assistant",
+            text: "",
+            activities: [
+              {
+                kind: "reasoning",
+                text: string(content.text),
+                createdAt: iso(record(content.time).created, started),
+              },
+            ],
+          });
+        else if (content.type === "tool") {
+          const activity = tool(
+            "opencode",
+            content,
+            iso(record(content.time).created, started),
+            iso(record(content.time).completed, completed),
+          );
+          const metadata = record(record(content.state).metadata);
+          const child = string(metadata.sessionID ?? metadata.childID);
+          const subagents: ReadonlyArray<AgentSessionSubagentActivity> = child
+            ? [
+                {
+                  id: child,
+                  prompt: string(record(record(content.state).input).prompt),
+                  title: string(content.name),
+                  status: activity.kind === "tool" && activity.failed ? "failed" : "completed",
+                  result: activity.kind === "tool" ? activity.output : null,
+                  createdAt: started,
+                  completedAt: completed,
+                },
+              ]
+            : [];
+          messages.push({
+            ...part,
+            role: "assistant",
+            text: "",
+            ...contentAttachments(record(content.state).content),
+            activities: [activity],
+            subagents,
+          });
+        } else
+          messages.push({
+            ...part,
+            role: "assistant",
+            text: "",
+            activities: [tool("opencode", { ...content, id: part.sourceId }, started, completed)],
+          });
+      }
+      if (message.error && array(message.content).length > 0)
+        messages.push({
+          ...common,
+          sourceId: `${sourceId}:error`,
+          role: "assistant",
+          text: JSON.stringify(message.error),
+        });
+    } else if (message.type === "shell") {
+      messages.push({
+        ...common,
+        role: "user",
+        text: "",
+        activities: [
+          tool(
+            "opencode",
+            {
+              ...message,
+              name: "bash",
+              state: {
+                status:
+                  message.status === "exited" &&
+                  typeof message.exit === "number" &&
+                  message.exit !== 0
+                    ? "failed"
+                    : message.status,
+                input: { command: message.command },
+                content: [
+                  {
+                    type: "text",
+                    text: string(message.output) || string(record(message.output).output),
+                  },
+                ],
+                metadata: { exit: message.exit },
+              },
+            },
+            started,
+            completed,
+          ),
+        ],
+      });
+    } else if (message.type === "compaction") {
+      messages.push({
+        ...common,
+        role: "assistant",
+        text: [
+          string(message.summary),
+          string(message.recent),
+          message.error ? JSON.stringify(message.error) : "",
+        ]
+          .filter(Boolean)
+          .join("\n\n"),
+        activities: [{ kind: "compaction", createdAt: started }],
+      });
+    } else {
+      const text = string(message.text) || string(message.description) || JSON.stringify(message);
+      messages.push({ ...common, role: "assistant", text });
+    }
+    if (message.type === "idle") nativeTurnId = undefined;
+  }
+  return {
+    source: "opencode",
+    providerInstanceId,
+    providerSessionId: id,
+    title: string(info.title) || "Imported OpenCode session",
+    model: modelOf(info.model),
+    createdAt,
+    updatedAt,
+    messages,
+  };
+}
diff --git a/apps/server/src/project/AgentSessionNativeProjection.ts b/apps/server/src/project/AgentSessionNativeProjection.ts
new file mode 100644
index 0000000000..0387e22d6c
--- /dev/null
+++ b/apps/server/src/project/AgentSessionNativeProjection.ts
@@ -0,0 +1,93 @@
+import { PlanId, type OrchestrationV2TurnItem } from "@t3tools/contracts";
+import { mcpToolPresentation } from "@t3tools/provider-core/server/mcpToolPresentation";
+import { openCodeToolTurnItem } from "@t3tools/provider-opencode/server/toolItems";
+import type { AgentSessionActivity } from "./AgentSessionScanner.ts";
+import { array, record, string } from "./AgentSessionNative.ts";
+
+type Base = Omit<
+  Extract<OrchestrationV2TurnItem, { type: "dynamic_tool" }>,
+  "type" | "toolName" | "input" | "output"
+>;
+export function nativeToolTurnItem(
+  base: Base,
+  activity: Extract<AgentSessionActivity, { kind: "tool" }>,
+): OrchestrationV2TurnItem {
+  const native = activity.native!;
+  const item = native.item;
+  if (native.source === "opencode") {
+    const state = record(item.state);
+    const projected = openCodeToolTurnItem(base, {
+      name: activity.name,
+      input: { ...record(state.input) },
+      output: activity.output ?? undefined,
+      completedMetadata: state.metadata,
+    });
+    return projected.type === "dynamic_tool"
+      ? { ...projected, output: JSON.stringify(item) }
+      : projected;
+  }
+  switch (item.type) {
+    case "plan":
+      return {
+        ...base,
+        type: "proposed_plan",
+        planId: PlanId.make(`${base.id}:plan`),
+        markdown: string(item.text),
+        streaming: false,
+      };
+    case "commandExecution":
+      return {
+        ...base,
+        type: "command_execution",
+        input: string(item.command),
+        ...(activity.output === null ? {} : { output: activity.output }),
+        ...(typeof item.exitCode === "number" ? { exitCode: item.exitCode } : {}),
+        ...(activity.failed ? { outputIndicatesFailure: true } : {}),
+      };
+    case "fileChange": {
+      const changes = array(item.changes).map(record);
+      return {
+        ...base,
+        type: "file_change",
+        fileName: string(changes[0]?.path) || "File changes",
+        diffStr: changes.map((change) => string(change.diff)).join("\n"),
+        changes: changes.map((change) => ({
+          operation: string(record(change.kind).type) || "update",
+          path: string(change.path) || "unknown",
+          ...(string(record(change.kind).move_path)
+            ? { oldPath: string(change.path), path: string(record(change.kind).move_path) }
+            : {}),
+        })),
+      };
+    }
+    case "webSearch":
+      return {
+        ...base,
+        type: "web_search",
+        patterns: [string(item.query)].filter(Boolean),
+        results: array(item.results).map((value) => {
+          const result = record(value);
+          return {
+            title: string(result.title),
+            ...(string(result.url) ? { url: string(result.url) } : {}),
+            snippet: string(result.snippet),
+          };
+        }),
+      };
+    // Keep the entire native record for less common and future tools. No input/output is silently dropped.
+    default:
+      return {
+        ...base,
+        type: "dynamic_tool",
+        ...(item.type === "mcpToolCall"
+          ? mcpToolPresentation({ toolName: item.tool, serverName: item.server })
+          : {}),
+        toolName:
+          item.type === "mcpToolCall"
+            ? `${string(item.server)}/${string(item.tool)}`
+            : activity.name,
+        input: activity.input,
+        output: JSON.stringify(item),
+      };
+  }
+}
