@@ -0,0 +1,322 @@
+import * as Crypto from "effect/Crypto";
+import {
+  ProviderInstanceId,
+  ProviderDriverKind,
+  resolveProviderInstanceEnabled,
+  type AgentSessionImportInput,
+  type AgentSessionListInput,
+  type AgentSessionListResult,
+  type ProviderInstanceConfig,
+} from "@t3tools/contracts";
+import { normalizeProjectPathForComparison } from "@t3tools/shared/path";
+import * as Context from "effect/Context";
+import * as DateTime from "effect/DateTime";
+import * as Effect from "effect/Effect";
+import * as Layer from "effect/Layer";
+import * as ServerSettings from "../serverSettings.ts";
+import {
+  array,
+  record,
+  string,
+  parseCodexSession,
+  parseOpenCode2Session,
+} from "./AgentSessionNative.ts";
+import * as Transport from "./AgentSessionNativeTransport.ts";
+import type { AgentSessionRecentThread } from "./AgentSessionScanner.ts";
+
+const MAX_BYTES = 512 * 1024 * 1024;
+const MAX_RECORDS = 100_000;
+const MAX_PAGES = 1000;
+const fail = (reason: Transport.NativeHistoryError["reason"]) =>
+  new Transport.NativeHistoryError({ reason });
+const encoded = (value: unknown) => JSON.stringify(value);
+function timestamp(value: unknown): string {
+  if (DateTime.isDateTime(value)) return DateTime.formatIso(value);
+  return DateTime.formatIso(
+    DateTime.makeUnsafe(typeof value === "number" ? value * 1000 : string(value)),
+  );
+}
+const active = (value: unknown) =>
+  ["active", "inProgress", "running", "streaming", "pending"].includes(string(value));
+function assertIdle(value: unknown, codex: boolean) {
+  const snapshot = record(value);
+  if (codex) {
+    if (
+      active(record(snapshot.status).type) ||
+      array(snapshot.turns).some((t) => active(record(t).status))
+    )
+      throw fail("active");
+  } else {
+    for (const raw of array(snapshot.messages)) {
+      const message = record(raw);
+      if (
+        active(message.status) ||
+        array(message.content).some((c) => active(record(record(c).state).status))
+      )
+        throw fail("active");
+      if (message.type === "assistant" && !record(message.time).completed && !message.error)
+        throw fail("active");
+    }
+  }
+}
+
+const make = Effect.gen(function* () {
+  const crypto = yield* Crypto.Crypto;
+  const transport = yield* Transport.AgentSessionNativeTransport;
+  const settings = yield* ServerSettings.ServerSettingsService;
+  const resolveInstance = Effect.fn("AgentSessionNativeSource.resolveInstance")(function* (
+    input: AgentSessionListInput,
+  ) {
+    const all = (yield* settings.getSettings).providerInstances;
+    const instanceId = input.providerInstanceId ?? ProviderInstanceId.make(input.source);
+    const instance: ProviderInstanceConfig | undefined =
+      all[instanceId] ??
+      (instanceId === input.source && !Object.hasOwn(all, input.source)
+        ? { driver: ProviderDriverKind.make(input.source) }
+        : undefined);
+    if (!instance || instance.driver !== input.source || !resolveProviderInstanceEnabled(instance))
+      return yield* fail("configuration");
+    return { instanceId, instance };
+  });
+  const pages = Effect.fn("AgentSessionNativeSource.pages")(function* (
+    client: Transport.NativeHistoryClient,
+    method: string,
+    params: Readonly<Record<string, unknown>>,
+    codex: boolean,
+  ) {
+    const entries: Array<unknown> = [];
+    const cursors = new Set<string>();
+    let cursor: string | undefined;
+    let size = 0;
+    for (let pageNumber = 0; pageNumber < MAX_PAGES; pageNumber++) {
+      const page = record(
+        yield* client.request(method, { ...params, ...(cursor ? { cursor } : {}) }),
+      );
+      if (!Array.isArray(page.data)) return yield* fail("protocol");
+      size += Buffer.byteLength(encoded(page));
+      if (entries.length + page.data.length > MAX_RECORDS) return yield* fail("limit");
+      entries.push(...page.data);
+      if (entries.length > MAX_RECORDS || size > MAX_BYTES) return yield* fail("limit");
+      const next = codex ? page.nextCursor : record(page.cursor).next;
+      if (next === null || next === undefined || next === "") return entries;
+      if (typeof next !== "string" || cursors.has(next)) return yield* fail("protocol");
+      cursors.add(next);
+      cursor = next;
+    }
+    return yield* fail("limit");
+  });
+  const list = Effect.fn("AgentSessionNativeSource.list")(function* (input: AgentSessionListInput) {
+    const { instanceId, instance } = yield* resolveInstance(input);
+    return yield* transport.withClient(instance, undefined, (client) =>
+      Effect.gen(function* () {
+        const codex = input.source === "codex";
+        const rows = codex
+          ? [
+              ...(yield* pages(client, "thread/list", { limit: 100, archived: false }, true)),
+              ...(yield* pages(client, "thread/list", { limit: 100, archived: true }, true)),
+            ]
+          : yield* pages(client, "list", {}, false);
+        const sessions: AgentSessionListResult["sessions"][number][] = [];
+        const ids = new Set<string>();
+        for (const row of rows) {
+          const entry = record(row);
+          const id = string(entry.id);
+          const workspaceRoot = string(codex ? entry.cwd : record(entry.location).directory);
+          if (!id || !workspaceRoot || ids.has(id)) continue;
+          ids.add(id);
+          sessions.push({
+            source: input.source,
+            providerInstanceId: instanceId,
+            sessionId: id,
+            workspaceRoot,
+            title: string(entry.name ?? entry.title ?? entry.preview),
+            updatedAt: timestamp(codex ? entry.updatedAt : record(entry.time).updated),
+          });
+        }
+        return {
+          sessions: sessions.sort((a, b) => b.updatedAt.localeCompare(a.updatedAt)),
+        } satisfies AgentSessionListResult;
+      }),
+    );
+  });
+  const read = Effect.fn("AgentSessionNativeSource.read")(function* (
+    input: AgentSessionImportInput,
+    workspace: string,
+  ) {
+    if ((input.source !== "codex" && input.source !== "opencode") || !input.sessionId)
+      return yield* fail("configuration");
+    const source = input.source;
+    const { instanceId, instance } = yield* resolveInstance({
+      source,
+      ...(input.providerInstanceId ? { providerInstanceId: input.providerInstanceId } : {}),
+    });
+    return yield* transport.withClient(instance, workspace, (client) =>
+      Effect.gen(function* () {
+        const codex = source === "codex";
+        let snapshot: Readonly<Record<string, unknown>>;
+        if (codex) {
+          const before = record(
+            record(
+              yield* client.request("thread/read", {
+                threadId: input.sessionId,
+                includeTurns: true,
+              }),
+            ).thread,
+          );
+          yield* Effect.try({
+            try: () => assertIdle(before, true),
+            catch: (cause) => (Transport.isNativeHistoryError(cause) ? cause : fail("protocol")),
+          });
+          const turns =
+            before.historyMode === "paginated" ||
+            array(before.turns).some(
+              (t) => record(t).itemsView === "summary" || record(t).itemsView === "notLoaded",
+            )
+              ? yield* pages(
+                  client,
+                  "thread/turns/list",
+                  {
+                    threadId: input.sessionId,
+                    limit: 100,
+                    sortDirection: "asc",
+                    itemsView: "full",
+                  },
+                  true,
+                )
+              : before.turns;
+          const after = record(
+            record(
+              yield* client.request("thread/read", {
+                threadId: input.sessionId,
+                includeTurns: true,
+              }),
+            ).thread,
+          );
+          if (
+            before.id !== after.id ||
+            before.cwd !== after.cwd ||
+            before.updatedAt !== after.updatedAt ||
+            encoded(before.status) !== encoded(after.status)
+          )
+            return yield* fail("changed");
+          const paginated =
+            before.historyMode === "paginated" ||
+            array(before.turns).some(
+              (t) => record(t).itemsView === "summary" || record(t).itemsView === "notLoaded",
+            );
+          const latestTurns = paginated
+            ? yield* pages(
+                client,
+                "thread/turns/list",
+                { threadId: input.sessionId, limit: 100, sortDirection: "asc", itemsView: "full" },
+                true,
+              )
+            : after.turns;
+          if (encoded(turns) !== encoded(latestTurns)) return yield* fail("changed");
+          snapshot = { ...before, turns };
+        } else {
+          const running = record(record(yield* client.request("active", {})).data);
+          if (running[input.sessionId!]) return yield* fail("active");
+          snapshot = record(yield* client.request("read", { sessionId: input.sessionId }));
+          const after = yield* client.request("read", { sessionId: input.sessionId });
+          if (encoded(snapshot) !== encoded(after)) return yield* fail("changed");
+          const latest = record(record(yield* client.request("active", {})).data);
+          if (latest[input.sessionId!]) return yield* fail("active");
+        }
+        if (!codex) {
+          const messages: Array<unknown> = [];
+          for (const raw of array(snapshot.messages)) {
+            const message = record(raw);
+            const output = record(message.output);
+            if (
+              message.type !== "shell" ||
+              !(output.truncated || Number(output.cursor) < Number(output.size))
+            ) {
+              messages.push(raw);
+              continue;
+            }
+            let cursor = 0;
+            let text = "";
+            let complete = false;
+            for (let page = 0; page < MAX_PAGES; page++) {
+              const chunk = record(
+                record(
+                  yield* client.request("shellOutput", {
+                    shellId: message.shellID,
+                    directory: workspace,
+                    cursor,
+                  }),
+                ).data,
+              );
+              if (
+                typeof chunk.cursor !== "number" ||
+                chunk.cursor <= cursor ||
+                chunk.size !== output.size ||
+                typeof chunk.output !== "string"
+              )
+                return yield* fail("protocol");
+              cursor = chunk.cursor;
+              text += chunk.output;
+              if (Buffer.byteLength(text) > MAX_BYTES) return yield* fail("limit");
+              if (cursor === chunk.size) {
+                complete = true;
+                break;
+              }
+            }
+            if (!complete) return yield* fail("limit");
+            messages.push({
+              ...message,
+              output: { output: text, size: output.size, cursor, truncated: false },
+            });
+          }
+          snapshot = { ...snapshot, messages };
+        }
+        const info = codex ? snapshot : record(snapshot.info);
+        const cwd = string(codex ? info.cwd : record(info.location).directory);
+        if (
+          info.id !== input.sessionId ||
+          normalizeProjectPathForComparison(cwd) !== normalizeProjectPathForComparison(workspace)
+        )
+          return yield* fail("identity");
+        const json = encoded(snapshot);
+        if (Buffer.byteLength(json) > MAX_BYTES) return yield* fail("limit");
+        const thread = yield* Effect.try({
+          try: () => {
+            assertIdle(snapshot, codex);
+            return codex
+              ? parseCodexSession(snapshot, instanceId)
+              : parseOpenCode2Session(snapshot, instanceId);
+          },
+          catch: (cause) =>
+            Transport.isNativeHistoryError(cause)
+              ? cause
+              : new Transport.NativeHistoryError({ reason: "protocol", cause }),
+        });
+        if (thread.messages.length > MAX_RECORDS) return yield* fail("limit");
+        const digest = yield* crypto.digest("SHA-256", new TextEncoder().encode(json));
+        const outcome: Extract<AgentSessionRecentThread, { _tag: "Importable" }> = {
+          _tag: "Importable",
+          thread,
+          source: {
+            provider: source,
+            providerInstanceId: instanceId,
+            providerSessionId: input.sessionId!,
+            filePath: `native://${source}/${instanceId}/${encodeURIComponent(input.sessionId!)}/${Buffer.from(digest).toString("hex")}`,
+            size: Buffer.byteLength(json),
+            mtimeMs: Date.parse(thread.updatedAt),
+            birthtimeMs: Date.parse(thread.createdAt),
+            device: 0,
+            inode: null,
+          },
+        };
+        return outcome;
+      }),
+    );
+  });
+  return { list, read };
+});
+export class AgentSessionNativeSource extends Context.Service<
+  AgentSessionNativeSource,
+  Effect.Success<typeof make>
+>()("t3/project/AgentSessionNativeSource") {}
+export const layer = Layer.effect(AgentSessionNativeSource, make);
