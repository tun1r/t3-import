+
+export class NativeHistoryError extends Schema.TaggedError<NativeHistoryError>()(
+  "NativeHistoryError",
+  {
+    reason: Schema.Literals([
+      "configuration",
+      "protocol",
+      "active",
+      "changed",
+      "identity",
+      "limit",
+      "attachment",
+    ]),
+    cause: Schema.optional(Schema.Defect()),
+  },
+) {
+  override get message() {
+    return `Native history import failed (${this.reason}). Close the source session and check the selected provider instance and workspace.`;
+  }
+}
+
+export const isNativeHistoryError = Schema.is(NativeHistoryError);
+const decodeCodexSettings = Schema.decodeEffect(CodexSettings);
+const decodeOpenCodeSettings = Schema.decodeEffect(OpenCodeSettings);
+
+export interface NativeHistoryClient {
+  readonly request: (
+    method: string,
+    params: Readonly<Record<string, unknown>>,
+  ) => Effect.Effect<unknown, NativeHistoryError>;
+}
+export class AgentSessionNativeTransport extends Context.Service<
+  AgentSessionNativeTransport,
+  {
+    readonly withClient: <A, E>(
+      instance: ProviderInstanceConfig,
+      directory: string | undefined,
+      use: (client: NativeHistoryClient) => Effect.Effect<A, E>,
+    ) => Effect.Effect<A, E | NativeHistoryError>;
+  }
+>()("t3/project/AgentSessionNativeTransport") {}
+
+const make = Effect.gen(function* () {
+  const crypto = yield* Crypto.Crypto;
+  const fs = yield* FileSystem.FileSystem;
+  const spawner = yield* ChildProcessSpawner.ChildProcessSpawner;
+  const host = yield* HostProcess.Environment;
+  const home = yield* HostProcess.HomeDirectory;
+  const path = yield* Path.Path;
+  const agentScope = yield* AgentScope;
+  const http = yield* HttpClient.HttpClient;
+  const runtime = yield* OpenCodeRuntime.OpenCodeRuntime;
+  return AgentSessionNativeTransport.of({
+    withClient: Effect.fn("AgentSessionNativeTransport.withClient")(
+      function* (instance, directory, use) {
+        const environment = {
+          ...host,
+          ...Object.fromEntries((instance.environment ?? []).map((v) => [v.name, v.value])),
+        };
+        const connect = Effect.gen(function* () {
+          if (instance.driver === "codex") {
+            const config = yield* decodeCodexSettings(instance.config ?? {});
+            const layout = yield* resolveCodexHomeLayout({
+              ...config,
+              homePath: config.homePath || environment.CODEX_HOME || "",
+            });
+            yield* materializeCodexShadowHome(layout);
+            const command = yield* makeCodexAppServerSpawnCommand({
+              command: expandHomePath(config.binaryPath || "codex", home),
+              args: codexAppServerArgs(resolveCodexLaunchArgs(config.launchArgs, environment)),
+              env: {
+                ...environment,
+                ...(layout.effectiveHomePath ? { CODEX_HOME: layout.effectiveHomePath } : {}),
+              },
+            });
+            const handle = yield* spawner.spawn(command);
+            const context = yield* Layer.build(CodexClient.layerChildProcess(handle));
+            const client = Context.get(context, CodexClient.CodexAppServerClient);
+            yield* client.request("initialize", {
+              clientInfo: { name: "t3-import", title: "T3 Import", version: "0.1.0" },
+              capabilities: { experimentalApi: true, optOutNotificationMethods: null },
+            });
+            yield* client.notify("initialized", undefined);
+            return yield* use({
+              request: (method, params) =>
+                client.raw
+                  .request(method, params)
+                  .pipe(
+                    Effect.mapError(
+                      (cause) => new NativeHistoryError({ reason: "protocol", cause }),
+                    ),
+                  ),
+            });
+          }
+          const config = yield* decodeOpenCodeSettings(instance.config ?? {});
+          const server = yield* OpenCode2Server.make({
+            binaryPath: expandHomePath(config.binaryPath || "opencode", home),
+            serverUrl: config.serverUrl,
+            serverPassword: config.serverPassword,
+            directory: directory ?? home,
+            environment,
+          });
+          return yield* server.withConnection(({ client }) =>
+            use({
+              request: (method, params) => {
+                const sessionID = string(params.sessionId);
+                return Effect.gen(function* () {
+                  if (method === "list")
+                    return yield* client.session.list({
+                      ...(params.cursor ? { cursor: params.cursor as never } : {}),
+                      limit: 100,
+                    });
+                  if (method === "active") return { data: yield* client.session.active() };
+                  if (method === "read")
+                    return yield* client.session.export({
+                      sessionID: sessionID as never,
+                      sanitize: false,
+                    });
+                  if (method === "shellOutput")
+                    return yield* client.shell.output({
+                      id: string(params.shellId) as never,
+                      location: { directory: string(params.directory) },
+                      cursor: Number(params.cursor),
+                      limit: 65536,
+                    });
+                  return yield* new NativeHistoryError({ reason: "protocol" });
+                }).pipe(
+                  Effect.mapError((cause) => new NativeHistoryError({ reason: "protocol", cause })),
+                );
+              },
+            }),
+          );
+        });
+        return yield* connect.pipe(
+          Effect.provideService(Path.Path, path),
+          Effect.provideService(AgentScope, agentScope),
+          Effect.provideService(OpenCodeRuntime.OpenCodeRuntime, runtime),
+          Effect.provide(OpenCode2Client.layer),
+          Effect.provideService(HttpClient.HttpClient, http),
+          Effect.provideService(Crypto.Crypto, crypto),
+          Effect.provideService(FileSystem.FileSystem, fs),
+          Effect.scoped,
+          Effect.mapError((cause) =>
+            isNativeHistoryError(cause)
+              ? cause
+              : new NativeHistoryError({ reason: "configuration", cause }),
+          ),
+        );
+      },
+    ),
+  });
+});
+export const layer = Layer.effect(AgentSessionNativeTransport, make);
