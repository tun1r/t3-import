+import {
+  AgentSessionImportInput,
+  EnvironmentHttpApi,
+  ORCHESTRATION_PROTOCOL_HEADER,
+  ProjectId,
+  ProviderInstanceId,
+} from "@t3tools/contracts";
+import * as Console from "effect/Console";
+import * as Effect from "effect/Effect";
+import * as Option from "effect/Option";
+import { Argument, Command, Flag } from "effect/cli";
+import { FetchHttpClient } from "effect/http";
+import * as HttpApiClient from "effect/http-api/HttpApiClient";
+
+const importProviderSessionCommand = Command.make("session", {
+  baseUrl: Flag.String("base-url").pipe(
+    Flag.withDescription("Origin of the running T3 server, for example http://127.0.0.1:3000."),
+  ),
+  token: Flag.String("token").pipe(
+    Flag.withDescription("Bearer session token with orchestration:operate access."),
+  ),
+  projectId: Argument.String("project-id").pipe(
+    Argument.withDescription("T3 project ID to receive the imported session."),
+  ),
+  sessionId: Argument.String("session-id").pipe(
+    Argument.withDescription("Claude Code, Codex, or OpenCode 2 native session ID."),
+  ),
+  source: Flag.Literals("provider", ["claudeAgent", "codex", "opencode"]).pipe(Flag.optional),
+  instance: Flag.String("instance").pipe(Flag.optional),
+  workspace: Flag.String("workspace").pipe(
+    Flag.withDescription(
+      "Expected project workspace path; prevents importing into a moved project.",
+    ),
+    Flag.optional,
+  ),
+  includeOlder: Flag.Boolean("include-older").pipe(
+    Flag.withDescription("Include sessions older than the normal discovery window."),
+  ),
+}).pipe(
+  Command.withDescription(
+    "Import one existing Claude Code, Codex, or OpenCode 2 session into a live T3 project.",
+  ),
+  Command.withHandler((flags) =>
+    Effect.gen(function* () {
+      const client = yield* HttpApiClient.make(EnvironmentHttpApi, {
+        baseUrl: flags.baseUrl,
+      });
+      const input = {
+        projectId: ProjectId.make(flags.projectId),
+        ...(Option.isNone(flags.source) ? {} : { source: flags.source.value }),
+        ...(Option.isNone(flags.instance)
+          ? {}
+          : { providerInstanceId: ProviderInstanceId.make(flags.instance.value) }),
+        ...(Option.isNone(flags.workspace) ? {} : { expectedWorkspaceRoot: flags.workspace.value }),
+        sessionId: flags.sessionId,
+        includeOlder: flags.includeOlder,
+      } satisfies AgentSessionImportInput;
+      const result = yield* client.agentSessions.import({
+        headers: {
+          authorization: `Bearer ${flags.token}`,
+          [ORCHESTRATION_PROTOCOL_HEADER]: "2",
+        },
+        payload: input,
+      });
+      yield* Console.log(
+        `Imported ${result.importedCount} session(s); skipped ${result.skippedCount}.`,
+      );
+    }).pipe(Effect.provide(FetchHttpClient.layer)),
+  ),
+);
+
+export const importSessionCommand = Command.make("import").pipe(
+  Command.withDescription("Import existing provider sessions into T3."),
+  Command.withSubcommands([importProviderSessionCommand]),
+);
